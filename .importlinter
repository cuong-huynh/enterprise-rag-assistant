[importlinter]
root_packages =
    assistant

[importlinter:contract:layers]
name = Layer contract: api → modules → integrations → core
type = layers
layers =
    assistant.api
    assistant.modules
    assistant.integrations
    assistant.core

[importlinter:contract:independence]
name = RAG and text2sql engines must not import each other
type = independence
modules =
    assistant.modules.rag
    assistant.modules.text2sql
