# Copy to .env and fill OPENAI_API_KEY. .env is gitignored — never commit it.
#
# LLM chain: .env → core/config.py (settings) → integrations/llm_client.py (ask_llm)
# Only RAG/hybrid document answers use the LLM; text2sql numbers do not.

# --- LLM (OpenAI-compatible: OpenAI, Google Gemini, NVIDIA NIM, ...) ---
LLM_MODE=real
OPENAI_API_KEY=

# Default = OpenAI. For Google AI Studio (Gemini), uncomment and set model:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (RAG ingest + retrieve) ---
EMBED_MODE=mock
# For Google AI Studio (Gemini) with OpenAI-compatible endpoint:
# EMBED_MODE=api
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBED_MODEL=text-embedding-004

# --- ERP (structured /query and /chat data route) ---
ERP_MODE=mock
# When ERP_MODE=odoo (Odoo lab on :8069 — see D:\odoo-lab):
# ODOO_URL=http://localhost:8069
# ODOO_DB=lab
# ODOO_USERNAME=admin@example.com
# ODOO_PASSWORD=admin

# --- Ingest queue (P5 Docker: queue + REDIS_URL; local/CI: sync) ---
INGEST_MODE=sync
# REDIS_URL=redis://localhost:6379/0

# --- Storage paths (override in Docker) ---
# CHROMA_PERSIST_DIR=data/processed/chroma
# INGEST_INBOX_DIR=data/ingest/inbox

# --- App ---
DEBUG=false
